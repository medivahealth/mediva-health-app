# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mediva_ai

# Redis
REDIS_URL=redis://localhost:6379

# JWT (auth.module reads JWT_EXPIRES_IN — set this explicitly)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# MSG91 (OTP)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=MEDIVA
MSG91_TEMPLATE_ID=your-template-id

# OpenRouter (AI)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pinecone (Vector DB) — use PINECONE_INDEX or PINECONE_INDEX_NAME
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=mediva-health
# PINECONE_INDEX_NAME=mediva-health

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=mediva-ai-documents

# Google Cloud Vision (OCR)
GCP_PROJECT_ID=your-gcp-project
GCP_API_KEY=your-gcp-api-key

# Gemini Live (native voice gateway /voice) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyDK6nnud0q3VScxmXnAiakJoNE4rBMH7rc
# Optional: GEMINI_VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Public URLs (use your LAN IP in dev so phone/email links work)
# BACKEND_URL=http://192.168.1.5:3000
# FRONTEND_URL=http://192.168.1.5:8081

# --- Option B (ngrok) — same host as "ngrok http 3000" Forwarding URL, NO /api ---
# BACKEND_URL=https://your-api-subdomain.ngrok-free.app
# FRONTEND_URL=https://your-api-subdomain.ngrok-free.app
# Or: powershell -File scripts\ngrok-update-env.ps1 -ApiUrl "https://..." -VoiceUrl "https://..." -UpdateBackendEnv
